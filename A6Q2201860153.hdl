CHIP A6Q2201860153 {
    IN a, b, c, d;
    OUT F;

    PARTS:
    Not(in=a, out=nota);
    Not(in=b, out=notb);
    Not(in=c, out=notc);
    Not(in=d, out=notd);

    And3(a=nota, b=notb, c=c, out=term1);
    And3(a=nota, b=notc, c=d, out=term2);
    And3(a=b, b=notc, c=d, out=term3);
    And4(a=a, b=notb, c=notc, d=notd, out=term4);

    Or4(a=term1, b=term2, c=term3, d=term4, out=F);
}
