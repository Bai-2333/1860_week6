CHIP A6Q2201860153 {
    IN a, b, c, d;
    OUT f;

    PARTS:
    // --- NOT gates ---
    Not(in=a, out=notA);
    Not(in=b, out=notB);
    Not(in=c, out=notC);
    Not(in=d, out=notD);

    // --- Term 1: !a & !b & !c & d ---
    And(a=notA, b=notB, out=t1ab);
    And(a=t1ab, b=notC, out=t1abc);
    And(a=t1abc, b=d, out=t1);

    // --- Term 2: !a & !b & c & !d ---
    And(a=notA, b=notB, out=t2ab);
    And(a=t2ab, b=c, out=t2abc);
    And(a=t2abc, b=notD, out=t2);

    // --- Term 3: !a & !b & c & d ---
    And(a=notA, b=notB, out=t3ab);
    And(a=t3ab, b=c, out=t3abc);
    And(a=t3abc, b=d, out=t3);

    // --- Term 4: !a & b & !c & d ---
    And(a=notA, b=b, out=t4ab);
    And(a=t4ab, b=notC, out=t4abc);
    And(a=t4abc, b=d, out=t4);

    // --- Term 5: a & !b & !c & !d ---
    And(a=a, b=notB, out=t5ab);
    And(a=t5ab, b=notC, out=t5abc);
    And(a=t5abc, b=notD, out=t5);

    // --- Term 6: a & b & !c & d ---
    And(a=a, b=b, out=t6ab);
    And(a=t6ab, b=notC, out=t6abc);
    And(a=t6abc, b=d, out=t6);

    // --- OR all terms together ---
    Or(a=t1, b=t2, out=o1);
    Or(a=o1, b=t3, out=o2);
    Or(a=o2, b=t4, out=o3);
    Or(a=o3, b=t5, out=o4);
    Or(a=o4, b=t6, out=f);
}
